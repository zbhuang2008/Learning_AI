 background-position: 50% 50%; background-repeat: no-repeat; display: block=
; }

.minishop_main_context { flex: 1 1 0%; }

.minishop_card_title { font-size: 17px; line-height: 1.2; font-weight: 500;=
 color: rgba(0, 0, 0, 0.9); display: block; width: auto; overflow: hidden; =
text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; }

.minishop_card_desc { color: var(--weui-FG-1); font-size: 15px; margin-top:=
 2px; width: auto; overflow: hidden; text-overflow: ellipsis; white-space: =
nowrap; overflow-wrap: normal; }

.minishop_card_profile { align-items: center; margin-top: 6px; line-height:=
 1.2; }

