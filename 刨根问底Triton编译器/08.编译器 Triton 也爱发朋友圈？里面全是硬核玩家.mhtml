x; font-weight: 400; width: auto; overflow: hidden; text-overflow: ellipsis=
; white-space: nowrap; overflow-wrap: normal; display: block; }

.minishop_extra_context { align-items: flex-end; justify-content: space-bet=
ween; margin-top: 2px; }

.minishop_extra_context .weui-btn { margin: 0px 0px 0px 16px; flex-shrink: =
0; }

em.minishop_card_price { display: block; width: auto; overflow: hidden; tex=
